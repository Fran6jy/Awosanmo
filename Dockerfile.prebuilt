# Runtime-only image for hosts too small to compile: the dist folders are built
# elsewhere and copied in, so the box only installs production dependencies.
FROM node:22-bookworm-slim
WORKDIR /app
ENV NODE_ENV=production DATA_DIR=/data PORT=4000
RUN apt-get update && apt-get install -y --no-install-recommends ffmpeg tini python3 make g++ \
  && rm -rf /var/lib/apt/lists/*
COPY package.json package-lock.json* ./
COPY apps/api/package.json apps/api/package.json
COPY apps/web/package.json apps/web/package.json
COPY apps/music/package.json apps/music/package.json
# better-sqlite3 compiles natively here; the toolchain is dropped afterwards.
RUN npm install --omit=dev --no-audit --no-fund \
  && apt-get purge -y python3 make g++ && apt-get autoremove -y && rm -rf /root/.npm
COPY apps/api/dist ./apps/api/dist
COPY apps/web/dist ./apps/web/dist
COPY apps/music/dist ./apps/music/dist
VOLUME ["/data"]
EXPOSE 4000
ENTRYPOINT ["/usr/bin/tini", "--"]
CMD ["node", "apps/api/dist/server.js"]
